<% cache @photoblog do %>
<section class="section">
  <h2 class="section__heading" id="elsewhere"><%= t('blog.elsewhere.heading').html_safe %></h2>
  <p><%= t('blog.elsewhere.cta').html_safe %></p>
  <ul class="elsewhere">
    <li class="elsewhere__item"><a href="<%= feed_url %>" title="Subscribe to Feed" aria-label="Subscribe to Feed"><%= inline_svg :rss_solid_full, class_name: 'elsewhere__icon' %><span class="elsewhere__label">Feed</span></a></li>
    <% if @photoblog.bluesky.present? %>
      <li class="elsewhere__item"><a href="<%= @photoblog.bluesky %>" rel="me" title="Follow on Bluesky" aria-label="Follow on Bluesky" target="_blank"><%= inline_svg :bluesky_brands_solid_full, class_name: 'elsewhere__icon' %><span class="elsewhere__label">Bluesky</span></a></li>
    <% end %>
    <% if @photoblog.flickr.present? %>
      <li class="elsewhere__item"><a href="<%= @photoblog.flickr %>" rel="me" title="Follow on Flickr" aria-label="Follow on Flickr" target="_blank"><%= inline_svg :flickr_brands_solid_full, class_name: 'elsewhere__icon' %><span class="elsewhere__label">Flickr</span></a></li>
    <% end %>
    <% if @photoblog.instagram.present? %>
      <li class="elsewhere__item"><a href="<%= @photoblog.instagram %>" rel="me" title="Follow on Instagram" aria-label="Follow on Instagram" target="_blank"><%= inline_svg :instagram_brands_solid_full, class_name: 'elsewhere__icon' %><span class="elsewhere__label">Instagram</span></a></li>
    <% end %>
    <% if @photoblog.mastodon.present? %>
      <li class="elsewhere__item"><a href="<%= @photoblog.mastodon %>" rel="me" title="Follow on Mastodon" aria-label="Follow on Mastodon" target="_blank"><%= inline_svg :mastodon_brands_solid_full, class_name: 'elsewhere__icon' %><span class="elsewhere__label">Mastodon</span></a></li>
    <% end %>
    <% if @photoblog.threads.present? %>
      <li class="elsewhere__item"><a href="<%= @photoblog.threads %>" rel="me" title="Follow on Threads" aria-label="Follow on Threads" target="_blank"><%= inline_svg :threads_brands_solid_full, class_name: 'elsewhere__icon' %><span class="elsewhere__label">Threads</span></a></li>
    <% end %>
  </ul>
</section>
<% end %>

