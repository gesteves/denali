<ul class="follow">
  <%= render partial: 'partials/follow_icon', locals: { url: about_url,                           icon: 'circle_info_solid_full',     label: "About #{@photoblog.name}" } %>
  <%= render partial: 'partials/follow_icon', locals: { url: search_url,                          icon: 'magnifying_glass_solid_full',    label: "Search #{@photoblog.name}" } if @photoblog.show_search? && @photoblog.has_search? %>
  <%= render partial: 'partials/follow_icon', locals: { url: "mailto:#{@photoblog.email}",        icon: 'envelope_solid_full',     label: 'Contact by email' }          if @photoblog.email.present? %>
  <%= render partial: 'partials/follow_icon', locals: { url: feed_url(format: 'atom', page: nil), icon: 'rss_solid_full',      label: 'Subscribe to Feed' } %>
  <%= render partial: 'partials/follow_icon', locals: { url: @photoblog.bluesky,                  icon: 'bluesky_brands_solid_full',   label: 'Follow on Bluesky',   rel: 'me', target: '_blank' } if @photoblog.bluesky.present? %>
  <%= render partial: 'partials/follow_icon', locals: { url: @photoblog.flickr,                   icon: 'flickr_brands_solid_full',    label: 'Follow on Flickr',    rel: 'me', target: '_blank' } if @photoblog.flickr.present? %>
  <%= render partial: 'partials/follow_icon', locals: { url: @photoblog.instagram,                icon: 'instagram_brands_solid_full', label: 'Follow on Instagram', rel: 'me', target: '_blank' } if @photoblog.instagram.present? %>
  <%= render partial: 'partials/follow_icon', locals: { url: @photoblog.mastodon,                 icon: 'mastodon_brands_solid_full',  label: 'Follow on Mastodon',  rel: 'me', target: '_blank' } if @photoblog.mastodon.present? %>
  <%= render partial: 'partials/follow_icon', locals: { url: @photoblog.threads,                  icon: 'threads_brands_solid_full',   label: 'Follow on Threads',   rel: 'me', target: '_blank' } if @photoblog.threads.present? %>
</ul>
