<% cache @photoblog do %>
<header class="header">
  <div class="header__section header__section--logo">
    <a href="/" class="header__link" aria-labelledby="header-photoblog-name">
      <h1>
        <% if @photoblog.header_logo_svg.present? %>
          <span class="sr-only" id="header-photoblog-name"><%= @photoblog.name %></span>
          <%= @photoblog.header_logo_svg.html_safe %>
        <% else %>
          <%= @photoblog.name %>
        <% end %>
      </h1>
    </a>
  </div>
  <div class="header__section header__section--tagline">
    <p class="header__tagline"><%= t('blog.tag_line') %></p>
  </div>
  <div class="header__section header__section--follow">
    <%= render partial: 'partials/follow', formats: :html %>
  </div>
</header>
<% end %>

