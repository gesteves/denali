<% content_for :head do %>
  <title><%= @page_title %></title>
  <meta name="description" content="<%= truncate @photoblog.plain_about, length: 200 %>">
  <link rel="canonical" href="<%= about_url %>">

  <meta property="og:title" content="About <%= @photoblog.name %>">
  <% if @photoblog.og_image.attached? %>
    <meta property="og:image" content="<%= @photoblog.og_image_url %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  <% elsif @photoblog.logo.attached? %>
    <meta property="og:image" content="<%= @photoblog.logo_url(width: 1200, height: 630, format: 'png', contain: true, background: 'fff') %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  <% end %>
  <meta property="og:description" content="<%= truncate @photoblog.plain_about, length: 200 %>">
  <meta property="og:url" content="<%= about_url %>">
  <meta property="og:type" content="Website">
  <meta property="og:site_name" content="<%= @photoblog.name %>">
  <meta property="og:locale" content="en_US">
  <%= auto_discovery_link_tag :atom, feed_url(format: 'atom'), title: @photoblog.name %>
<% end %>

<article class="entry">
  <div class="entry__body">
    <h2 class="entry__headline">About <cite><%= @photoblog.name %></cite></h2>
    <%= @photoblog.formatted_about %>
  </div>
</article>
<%= render partial: 'partials/elsewhere' %>
<%= render partial: 'partials/push_notifications' %>
