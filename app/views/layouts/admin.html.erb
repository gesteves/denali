<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width">
  <meta name="turbo-cache-control" content="no-cache">
  <meta name="robots" content="noindex">
  <%= yield :meta %>
  <%= yield :head %>
  <title><%= @page_title.nil? ? '' : "#{@page_title} – " %><%= @photoblog.name %></title>
  <%= yield :stylesheets %>
  <%= stylesheet_link_tag 'admin', media: 'all', 'data-turbo-track': 'reload' %>
  <%= csrf_meta_tags %>
  <%= yield :javascript %>
  <%# A module (deferred like before), since the build splits Mapbox into a chunk it imports. %>
  <%= javascript_include_tag 'admin', type: 'module', 'data-turbo-track': 'reload' %>
  <script src="https://kit.fontawesome.com/2935e37c07.js" crossorigin="anonymous"></script>
</head>
<body data-controller="notifications" data-action="notify->notifications#add" <% if content_for?(:body_class) %>class="<%= yield :body_class %>"<% end %>>
  <%= render partial: 'admin/shared/nav' %>

  <% if @no_container %>
    <%= yield %>
  <% else %>
    <section class="section">
      <div class="container">
        <%= yield %>
      </div>
    </section>
  <% end %>

  <%# Not data-turbo-permanent: Turbo would keep the previous page's copy and drop this one, flash and all. %>
  <div id="notifications" class="notifications" data-notifications-target="container" data-action="transitionend->notifications#toggle">
    <% flash.each do |name, message| -%>
      <div class="notification is-<%= name %> is-transparent" data-notifications-target="notification" data-action="click->notifications#close">
        <%= message %>
      </div>
    <% end %>
  </div>

</body>
</html>
