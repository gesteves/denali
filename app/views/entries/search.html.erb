<% if @query.present? %>
  <% content_for :head do %>
    <%= render partial: 'entries/search/head' %>
  <% end %>

  <% content_for :inline_css do %>
    <%= render partial: 'partials/inline_styles', locals: { stylesheet: 'entry_list.css' } %>
  <% end %>

  <%= render partial: 'entries/search/body' %>
<% else %>
  <%= render partial: 'entries/search/search' %>
<% end %>
