<% if suggested_tags.present? %>
  <aside class="section section--no-border" aria-label="Suggested Tags">
    <p><%= title %></p>
    <ul class="tags">
      <% suggested_tags.each do |tag| %>
        <li><%= link_to tag.name, tag_url(tag.slug), { rel: 'tag', title: "All photos tagged ”#{tag.name}”", 'aria-label': tag.name } %></li>
      <% end %>
    </ul>
  </aside>
<% end %>
