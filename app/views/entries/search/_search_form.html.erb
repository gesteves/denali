<section class="section section--no-border">
<%= form_with(url: search_url, method: :get, class: 'search', role: 'search') do %>
  <div class="search__input-wrapper">
    <%= inline_svg :magnifying_glass_solid_full, class_name: 'search__icon' %>
    <%= text_field_tag :q, @query || '', placeholder: "What would you like to see?", class: 'search__input', autofocus: true, 'aria-label': 'Search' %>
  </div>
<% end %>
</section>
