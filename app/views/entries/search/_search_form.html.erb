<%= form_tag(search_url, method: 'get', class: 'search') do %>
  <div class="search__input-wrapper">
    <svg class="search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <%= text_field_tag :q, @query || '', placeholder: "What would you like to see?", class: 'search__input', autofocus: true %>
  </div>
<% end %>
