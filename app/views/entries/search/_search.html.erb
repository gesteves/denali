<% content_for :head do %>
  <title><%= @page_title %></title>
  <meta name="description" content="<%= @photoblog.meta_description %>">
  <link rel="canonical" href="<%= search_url %>">

  <meta property="og:title" content="<%= "Search – #{@photoblog.name}" %>">
  <meta property="og:description" content="<%= @photoblog.plain_tag_line %>">
  <meta property="og:url" content="<%= search_url %>">
  <meta property="og:type" content="Website">
  <meta property="og:site_name" content="<%= @photoblog.name %>">
  <meta property="og:locale" content="en_US">
<% end %>

<%= render partial: 'entries/search/search_form' %>
<% if  @suggested_tags.present? %>
  <%= render partial: 'entries/search/tag_suggestions',
            locals: { title: "Need some ideas? Explore these popular tags.", suggested_tags: @suggested_tags, query: @query } %>
<% end %>
