<% cache [@photoblog, @query.parameterize, @page, @count, @suggested_tags&.map(&:id)] do %>
  <%= render partial: 'entries/search/search_form' %>

  <% if @entries.present? %>
    <%= render partial: 'entries/search/tag_suggestions',
              locals: { title: "Looking for more? Here are some tags related to your search.", suggested_tags: @suggested_tags, query: @query } %>
  <% else %>
    <%= render partial: 'entries/search/tag_suggestions',
              locals: { title: "No results found, but here are some tags you can explore.", suggested_tags: @suggested_tags, query: @query } %>
  <% end %>

  <% if @entries.present? %>
    <main data-controller="infinite-scroll" data-infinite-scroll-base-url-value="<%= @base_url %>" data-infinite-scroll-current-page-value="<%= @page %>">
      <h2 id="search-results" class="sr-only"><%= @heading_title %></h2>
      <ol class="entry-list" data-infinite-scroll-target="container" data-controller="grid" aria-busy="false" aria-labelledby="search-results">
        <%= render partial: 'entries/list/page', object: @entries.to_a, as: :entries, locals: { page_url: @page_url }  %>
      </ol>
      <%= paginate @entries, target: 'infinite-scroll.paginator' %>
      <%= render partial: 'partials/loading', locals: { target: 'infinite-scroll.spinner' } %>
    </main>
  <% end %>
<% end %>

