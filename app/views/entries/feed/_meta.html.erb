<% if entry.photos.first.camera.present? || entry.show_location? %>
  <hr>
  <p>
    <%= render partial: 'entries/feed/exif', formats: :html, object: entry.photos.first, as: :photo if entry.photos.first.camera.present?  %>
    <%= render partial: 'entries/feed/location', formats: :html, object: entry.photos.first, as: :photo if entry.show_location? %>
  </p>
<% end %>
