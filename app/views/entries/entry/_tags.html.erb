<div class="entry__meta-item">
  <h3 class="sr-only" id="tags">Tags</h3>
  <ul class="tags" aria-labelledby="tags">
    <% tags.sort_by { |t| t.name }.each do |tag| %>
      <li>
        <%= link_to tag_url(tag.slug), { rel: 'tag', title: "All photos tagged “#{tag.name}”", 'aria-label': tag.name } do %>
          <%= inline_svg :tag_light_full, class_name: 'tags__icon' %>
          <span class="tags__label"><%= tag.name %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
