<% cache entry do %>
  <article role="main" class="entry" data-controller="photo" data-photo-container-max-width-value="1680">
    <div class="entry__photos">
      <%= render partial: 'entries/entry/photo', collection: @photos, as: :photo, cached: true %>
    </div>
    <div class="entry__body">
      <h2 class="entry__headline">
        <%= entry.plain_title %>
      </h2>
      <%= entry.formatted_body unless entry.body.blank? %>
    </div>
    <aside class="section section--border-thin">
      <%= render partial: 'entries/entry/date', object: entry, as: :entry %>
      <%= render partial: 'entries/entry/exif', object: @photos.first, as: :photo if entry.is_single_photo? %>
      <%= render partial: 'entries/entry/location', object: entry, as: :entry, locals: { photo: @photos&.first } if entry.show_location? %>
      <%= render partial: 'entries/entry/tags', object: entry.combined_tags, as: :tags %>
    </aside>
  </article>
<% end %>
