<div class="entry__meta-item">
  <%= inline_svg :calendar_light_full, class_name: 'entry__meta-icon' %>
  <p>
    <% if entry.is_published? %>
      Published on <%= entry.published_at.strftime('%B %-d, %Y') %>
    <% elsif entry.is_queued? && (publish_date = entry.publish_date_for_queued).present? %>
      Queued for <%= publish_date.strftime('%B %-d, %Y') %>
    <% elsif entry.is_queued? %>
      Queued
    <% elsif entry.is_draft? %>
      Drafted
    <% end %>
  </p>
</div>
<hr>
