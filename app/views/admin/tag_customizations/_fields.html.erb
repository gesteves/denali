<div class="field is-horizontal" data-controller="tag-autocomplete">
  <div class="field-label is-normal">
    <%= f.label :tag_list, 'Entry tags', class: 'label' %>
  </div>
  <div class="field-body">
    <div class="field">
      <div class="control is-expanded">
        <%= f.text_field :tag_list, value: @tag_customization.tag_list.to_s, autocomplete: 'off', required: true, placeholder: 'A list of tags, separated by commas…', class: 'input', 'data-tag-autocomplete-target': 'tags' %>
      </div>
      <p class="help">Settings will apply to entries tagged with all of these tags.</p>
    </div>
  </div>
  <%= render partial: 'admin/shared/tag_datalists', locals: { tags: @tags } %>
</div>

<hr class="hr">
<h2 class="subtitle is-size-5-mobile">Bluesky</h2>

<div class="field is-horizontal">
  <div class="field-label is-normal">
    <%= f.label :bluesky_hashtags, 'Hashtags', class: 'label' %>
  </div>
  <div class="field-body">
    <div class="field">
      <div class="control is-expanded">
        <%= f.text_area :bluesky_hashtags, placeholder: 'Enter hashtags, one per line…', class: 'textarea', rows: 10 %>
        <p class="help">Entries will be shared on Bluesky using a random selection of these hashtags.</p>
      </div>
    </div>
  </div>
</div>

