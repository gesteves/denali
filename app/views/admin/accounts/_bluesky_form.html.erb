<%= form_with model: social_account, url: bluesky_admin_accounts_path, class: 'box', data: { inline_form_target: 'form' } do |f| %>
  <% if error.present? %>
    <div class="notification is-danger is-light mb-4">
      <%= error %>
    </div>
  <% end %>

  <div class="field">
    <label class="label">Server</label>
    <div class="control">
      <%= f.text_field :server_url, class: 'input', placeholder: 'https://bsky.social' %>
    </div>
  </div>

  <div class="field">
    <label class="label">Handle</label>
    <div class="control">
      <%= f.text_field :handle, class: 'input', placeholder: 'yourhandle.bsky.social' %>
    </div>
    <p class="help">Your Bluesky handle (without the @)</p>
  </div>

  <div class="field">
    <label class="label">App Password</label>
    <div class="control">
      <%= f.password_field :access_token, class: 'input', placeholder: 'xxxx-xxxx-xxxx-xxxx' %>
    </div>
    <p class="help">
      Create an app password in your
      <a href="https://bsky.app/settings/app-passwords" target="_blank" rel="noopener">Bluesky settings</a>.
    </p>
  </div>

  <div class="field is-grouped">
    <div class="control">
      <%= f.submit 'Save', class: 'button is-success' %>
    </div>
    <div class="control">
      <button type="button" class="button" data-action="inline-form#hide">Cancel</button>
    </div>
  </div>
<% end %>
