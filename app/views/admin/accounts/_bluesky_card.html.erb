<div id="bluesky-card">
  <h2 class="subtitle is-size-5-mobile">Bluesky</h2>

  <% if social_account&.persisted? %>
    <div class="box">
      <div class="level is-mobile">
        <div class="level-left">
          <div class="level-item">
            <div>
              <p class="has-text-weight-semibold mb-2">
                <span class="icon-text">
                  <span class="icon"><i class="fa-brands fa-bluesky"></i></span>
                  <span><%= link_to "@#{social_account.handle}", "https://bsky.app/profile/#{social_account.handle}", target: "_blank", rel: "noopener" %></span>
                </span>
              </p>
              <div class="field is-grouped is-grouped-multiline">
                <div class="control">
                  <div class="tags has-addons">
                    <span class="tag is-success">Added</span>
                    <span class="tag"><%= time_ago_in_words(social_account.created_at) %> ago</span>
                  </div>
                </div>
                <div class="control">
                  <div class="tags has-addons">
                    <span class="tag is-info">Server</span>
                    <span class="tag"><%= social_account.server_url.sub(/\Ahttps?:\/\//, '') %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="level-right">
          <div class="level-item">
            <%= button_to 'Disconnect', bluesky_admin_accounts_path,
                method: :delete,
                form: { data: { turbo_confirm: 'Disconnect this Bluesky account?' } },
                class: 'button is-danger is-small' %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <% social_account ||= SocialAccount.new(provider: 'bluesky', server_url: 'https://bsky.social') %>
    <% show_form = error.present? || local_assigns[:show_form] %>

    <div data-controller="inline-form" data-inline-form-button-text-value="Save">
      <% if show_form %>
        <%# Show form directly when there's an error %>
        <%= render 'admin/accounts/bluesky_form', social_account: social_account, error: error %>
      <% else %>
        <div data-inline-form-target="placeholder">
          <button type="button" class="button" data-action="inline-form#show">
            <span class="icon"><i class="fa-brands fa-bluesky"></i></span>
            <span>Connect with Bluesky</span>
          </button>
        </div>
      <% end %>

      <template data-inline-form-target="template">
        <%= render 'admin/accounts/bluesky_form', social_account: social_account, error: nil %>
      </template>
    </div>
  <% end %>
</div>
