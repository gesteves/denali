<div id="mastodon-card">
  <h2 class="subtitle is-size-5-mobile">Mastodon</h2>

  <% if social_account&.persisted? %>
    <div class="card">
      <div class="card-content">
        <p class="has-text-weight-semibold">
          <span class="icon-text">
            <span class="icon"><i class="fa-brands fa-mastodon"></i></span>
            <span><%= link_to "@#{social_account.handle}", "#{social_account.server_url}/@#{social_account.handle.split('@').first}", target: "_blank", rel: "noopener" %></span>
          </span>
        </p>
        <hr class="hr">
        <div class="level is-mobile">
          <div class="level-left">
            <div class="level-item">
              <div class="field is-grouped is-grouped-multiline">
                <div class="control">
                  <div class="tags has-addons">
                    <span class="tag is-success">Added</span>
                    <span class="tag"><%= time_ago_in_words(social_account.created_at) %> ago</span>
                  </div>
                </div>
                <div class="control">
                  <div class="tags has-addons">
                    <span class="tag is-info">Server</span>
                    <span class="tag"><%= social_account.server_url.sub(/\Ahttps?:\/\//, '') %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="level-right">
            <div class="level-item">
              <%= button_to 'Disconnect', mastodon_admin_accounts_path,
                  method: :delete,
                  form: { data: { turbo_confirm: 'Disconnect this Mastodon account?' } },
                  class: 'button is-danger is-small' %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <% show_form = error.present? || local_assigns[:show_form] %>

    <div data-controller="inline-form">
      <% if show_form %>
        <%# Show form directly when there's an error %>
        <%= render 'admin/accounts/mastodon_form', error: error %>
      <% else %>
        <div data-inline-form-target="placeholder">
          <button type="button" class="button" data-action="inline-form#show">
            <span class="icon"><i class="fa-brands fa-mastodon"></i></span>
            <span>Connect with Mastodon</span>
          </button>
        </div>
      <% end %>

      <template data-inline-form-target="template">
        <%= render 'admin/accounts/mastodon_form', error: nil %>
      </template>
    </div>
  <% end %>
</div>
