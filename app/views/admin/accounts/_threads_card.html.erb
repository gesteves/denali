<div id="threads-card">
  <h2 class="subtitle is-size-5-mobile">Threads</h2>

  <% if social_account&.persisted? %>
    <div class="box">
      <div class="level is-mobile">
        <div class="level-left">
          <div class="level-item">
            <div>
              <p class="has-text-weight-semibold mb-2">
                <%= link_to "@#{social_account.handle}", "https://threads.net/@#{social_account.handle}", target: "_blank", rel: "noopener" %>
              </p>
              <div class="tags has-addons">
                <span class="tag is-success">Added</span>
                <span class="tag"><%= time_ago_in_words(social_account.created_at) %> ago</span>
              </div>
            </div>
          </div>
        </div>
        <div class="level-right">
          <div class="level-item">
            <%= button_to 'Disconnect', threads_admin_accounts_path,
                method: :delete,
                form: { data: { turbo_confirm: 'Disconnect this Threads account?' } },
                class: 'button is-danger is-small' %>
          </div>
        </div>
      </div>
    </div>
  <% elsif ENV['THREADS_APP_ID'].present? && ENV['THREADS_APP_SECRET'].present? %>
    <% if error.present? %>
      <div class="notification is-danger is-light">
        <%= error %>
      </div>
    <% end %>
    <%= button_to threads_admin_accounts_path,
        method: :post,
        form: { data: { turbo: false } },
        class: 'button' do %>
      <span class="icon"><i class="fa-brands fa-threads"></i></span>
      <span>Connect with Threads</span>
    <% end %>
  <% else %>
    <p class="has-text-grey">Threads API credentials are not configured.</p>
  <% end %>
</div>
