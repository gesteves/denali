<%= form_with url: mastodon_admin_accounts_path, method: :post, class: 'box', data: { inline_form_target: 'form', turbo: false } do |f| %>
  <% if error.present? %>
    <div class="notification is-danger is-light mb-4">
      <%= error %>
    </div>
  <% end %>

  <div class="field">
    <label class="label">Instance URL</label>
    <div class="control">
      <%= f.text_field :instance_url, name: 'instance_url', class: 'input', placeholder: 'mastodon.social' %>
    </div>
    <p class="help">Enter your Mastodon instance URL (e.g., mastodon.social, hachyderm.io)</p>
  </div>

  <div class="field is-grouped">
    <div class="control">
      <%= f.submit 'Connect with Mastodon', class: 'button is-success' %>
    </div>
    <div class="control">
      <button type="button" class="button" data-action="inline-form#hide">Cancel</button>
    </div>
  </div>
<% end %>
