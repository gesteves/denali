<div id="instagram-card">
  <h2 class="subtitle is-size-5-mobile">Instagram</h2>

  <% if social_account&.persisted? %>
    <div class="box">
      <div class="level is-mobile">
        <div class="level-left">
          <div class="level-item">
            <div>
              <p class="has-text-weight-semibold mb-2">
                <span class="icon-text">
                  <span class="icon"><i class="fa-brands fa-instagram"></i></span>
                  <span><%= link_to "@#{social_account.handle}", "https://instagram.com/#{social_account.handle}", target: "_blank", rel: "noopener" %></span>
                </span>
              </p>
              <div class="field is-grouped is-grouped-multiline">
                <div class="control">
                  <div class="tags has-addons">
                    <span class="tag is-success">Added</span>
                    <span class="tag"><%= time_ago_in_words(social_account.created_at) %> ago</span>
                  </div>
                </div>
                <% if social_account.connected_at.present? %>
                  <% token_expires_at = social_account.connected_at + 60.days %>
                  <div class="control">
                    <div class="tags has-addons">
                      <span class="tag <%= token_expiration_status_class(social_account.connected_at) %>">Token expires</span>
                      <span class="tag"><%= token_expires_at < Time.current ? 'Expired' : "in #{time_ago_in_words(token_expires_at)}" %></span>
                    </div>
                  </div>
                <% end %>
                <% last_shared = Entry.maximum(:last_shared_on_instagram_at) %>
                <% if last_shared.present? %>
                  <div class="control">
                    <div class="tags has-addons">
                      <span class="tag is-info">Last shared</span>
                      <span class="tag"><%= time_ago_in_words(last_shared) %> ago</span>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <div class="level-right">
          <div class="level-item">
            <%= button_to 'Disconnect', instagram_admin_accounts_path,
                method: :delete,
                form: { data: { turbo_confirm: 'Disconnect this Instagram account?' } },
                class: 'button is-danger is-small' %>
          </div>
        </div>
      </div>
    </div>
  <% elsif ENV['INSTAGRAM_APP_ID'].present? && ENV['INSTAGRAM_APP_SECRET'].present? %>
    <% if error.present? %>
      <div class="notification is-danger is-light">
        <%= error %>
      </div>
    <% end %>
    <%= button_to instagram_admin_accounts_path,
        method: :post,
        form: { data: { turbo: false } },
        class: 'button' do %>
      <span class="icon"><i class="fa-brands fa-instagram"></i></span>
      <span>Connect with Instagram</span>
    <% end %>
  <% else %>
    <p class="has-text-grey">Instagram API credentials are not configured.</p>
  <% end %>
</div>
