<div id="instagram-card">
  <h2 class="subtitle is-size-5-mobile">Instagram</h2>

  <% if social_account&.persisted? %>
    <div class="box">
      <div class="level is-mobile">
        <div class="level-left">
          <div class="level-item">
            <div>
              <p class="has-text-weight-semibold">
                <%= link_to "@#{social_account.handle}", "https://instagram.com/#{social_account.handle}", target: "_blank", rel: "noopener" %>
              </p>
              <p class="is-size-7 has-text-grey">Added <%= time_ago_in_words(social_account.created_at) %> ago</p>
            </div>
          </div>
        </div>
        <div class="level-right">
          <div class="level-item">
            <%= button_to 'Disconnect', instagram_admin_accounts_path,
                method: :delete,
                form: { data: { turbo_confirm: 'Disconnect this Instagram account?' } },
                class: 'button is-danger is-outlined is-small' %>
          </div>
        </div>
      </div>
    </div>
  <% elsif ENV['INSTAGRAM_APP_ID'].present? && ENV['INSTAGRAM_APP_SECRET'].present? %>
    <% if error.present? %>
      <div class="notification is-danger is-light">
        <%= error %>
      </div>
    <% end %>
    <%= button_to 'Connect with Instagram', instagram_admin_accounts_path,
        method: :post,
        form: { data: { turbo: false } },
        class: 'button is-info is-outlined' %>
  <% else %>
    <p class="has-text-grey">Instagram API credentials are not configured.</p>
  <% end %>
</div>
