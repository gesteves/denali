<div class="modal is-active"  data-controller="modal character-counter" data-character-counter-max-length-value="300">
  <div class="modal-background" data-action="click->modal#close"></div>
  <div class="modal-card">
    <%= form_with url: bluesky_admin_entry_path(@entry.id), method: :post, local: false, html: { 'data-action': 'ajax:success->modal#close' } do |form| %>
    <header class="modal-card-head">
      <h1 class="modal-card-title">Share on Bluesky</h1>
      <button class="delete" data-action="click->modal#close"></button>
    </header>
    <section class="modal-card-body">
      <div class="content">
        <div class="field">
          <div class="control is-expanded">
            <%= form.text_area :text, value: @text.html_safe, placeholder: 'Your Bluesky caption…', required: true, class: 'textarea', rows: 8, 'data-character-counter-target': 'input', 'data-action': 'input->character-counter#updateCharacterCount' %>
          </div>
          <p class="help"><span data-character-counter-target="characterCount">0</span>/300</p>
        </div>
        <div class="field">
          <label class="label">In reply to</label>
          <div class="control is-expanded">
            <%= form.text_field :in_reply_to, placeholder: 'https://bsky.app/profile/allencompassingtrip.com/post/3lbpl6yom3t2w', class: 'input', autocomplete: 'off' %>
          </div>
          <p class="help">The photo will be published as a reply to this post.</p>
        </div>
        <div class="field">
          <label class="label">Repost with quote</label>
          <div class="control is-expanded">
            <%= form.text_field :quote, placeholder: 'https://bsky.app/profile/allencompassingtrip.com/post/3lbpl6yom3t2w', class: 'input', autocomplete: 'off' %>
          </div>
          <p class="help">The photo will be published quoting this post.</p>
        </div>
        <hr class="hr">
        <div class="field is-grouped is-grouped-multiline">
          <div class="control">
            <%= last_shared_on_bluesky_tag(@entry) %>
          </div>
        </div>
      </div>
    </section>
    <footer class="modal-card-foot">
      <div class="field is-grouped">
        <p class="control">
          <%= form.submit "Share", class: 'button is-success', 'data-character-counter-target': 'submit' %>
        </p>
        <p class="control">
          <button class="button is-light" data-action="click->modal#close">Cancel</button>
        </p>
      </div>
    </footer>
    <% end %>
  </div>
</div>
