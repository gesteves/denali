<div class="modal is-active" data-controller="modal">
  <div class="modal-background" data-action="click->modal#close"></div>
  <div class="modal-card">
    <%= form_with model: [:admin, @entry], url: sharing_settings_admin_entry_path(@entry.id), method: :post, local: false, html: { 'data-action': 'ajax:success->modal#close' } do |form| %>
    <header class="modal-card-head">
      <h1 class="modal-card-title">Sharing Settings</h1>
      <button class="delete" data-action="click->modal#close"></button>
    </header>
    <section class="modal-card-body">
      <div class="content">
        <p class="label">Automatically share on...</p>
        <div class="checkboxes">
          <label class="checkbox">
            <%= form.check_box :post_to_bluesky %>
            Bluesky
          </label>
          <label class="checkbox">
            <%= form.check_box :post_to_mastodon %>
            Mastodon
          </label>
          <label class="checkbox">
            <%= form.check_box :post_to_instagram %>
            Instagram
          </label>
          <label class="checkbox">
            <%= form.check_box :post_to_threads %>
            Threads
          </label>
        </div>
      </div>
    </section>
    <footer class="modal-card-foot">
      <div class="field is-grouped">
        <p class="control">
          <%= form.submit "Save", class: 'button is-success' %>
        </p>
        <p class="control">
          <button class="button is-light" data-action="click->modal#close">Cancel</button>
        </p>
      </div>
    </footer>
    <% end %>
  </div>
</div>

