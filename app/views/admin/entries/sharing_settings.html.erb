<div class="modal is-active" data-controller="modal">
  <div class="modal-background" data-action="click->modal#close"></div>
  <div class="modal-card">
    <%= form_with model: [:admin, @entry], url: sharing_settings_admin_entry_path(@entry.id), method: :post, local: false, html: { 'data-action': 'ajax:success->modal#close' } do |form| %>
    <header class="modal-card-head">
      <h1 class="modal-card-title">Sharing Settings</h1>
      <button class="delete" data-action="click->modal#close"></button>
    </header>
    <section class="modal-card-body">
      <div class="content">
        <div class="columns is-multiline">
          <div class="column is-half">
            <div class="field is-grouped is-grouped-multiline">
              <div class="control">
                <span class="label is-size-6" style="margin-right: 0.75rem; margin-bottom: 0;">Bluesky</span>
              </div>
              <div class="control">
                <div class="tabs is-toggle is-small" data-controller="radio-tab">
                  <ul>
                    <li data-radio-tab-target="tab" data-radio-tab-value="true" data-action="click->radio-tab#toggle">
                      <a>
                        Yes
                      </a>
                    </li>
                    <li data-radio-tab-target="tab" data-radio-tab-value="false" data-action="click->radio-tab#toggle">
                      <a>
                        No
                      </a>
                    </li>
                  </ul>
                  <%= form.hidden_field :post_to_bluesky, value: @entry.post_to_bluesky.to_s, 'data-radio-tab-target': 'field' %>
                </div>
              </div>
            </div>
          </div>

          <div class="column is-half">
            <div class="field is-grouped is-grouped-multiline">
              <div class="control">
                <span class="label is-size-6" style="margin-right: 0.75rem; margin-bottom: 0;">Mastodon</span>
              </div>
              <div class="control">
                <div class="tabs is-toggle is-small" data-controller="radio-tab">
                  <ul>
                    <li data-radio-tab-target="tab" data-radio-tab-value="true" data-action="click->radio-tab#toggle">
                      <a>
                        Yes
                      </a>
                    </li>
                    <li data-radio-tab-target="tab" data-radio-tab-value="false" data-action="click->radio-tab#toggle">
                      <a>
                        No
                      </a>
                    </li>
                  </ul>
                  <%= form.hidden_field :post_to_mastodon, value: @entry.post_to_mastodon.to_s, 'data-radio-tab-target': 'field' %>
                </div>
              </div>
            </div>
          </div>

          <div class="column is-half">
            <div class="field is-grouped is-grouped-multiline">
              <div class="control">
                <span class="label is-size-6" style="margin-right: 0.75rem; margin-bottom: 0;">Instagram</span>
              </div>
              <div class="control">
                <div class="tabs is-toggle is-small" data-controller="radio-tab">
                  <ul>
                    <li data-radio-tab-target="tab" data-radio-tab-value="true" data-action="click->radio-tab#toggle">
                      <a>
                        Yes
                      </a>
                    </li>
                    <li data-radio-tab-target="tab" data-radio-tab-value="false" data-action="click->radio-tab#toggle">
                      <a>
                        No
                      </a>
                    </li>
                  </ul>
                  <%= form.hidden_field :post_to_instagram, value: @entry.post_to_instagram.to_s, 'data-radio-tab-target': 'field' %>
                </div>
              </div>
            </div>
          </div>

          <div class="column is-half">
            <div class="field is-grouped is-grouped-multiline">
              <div class="control">
                <span class="label is-size-6" style="margin-right: 0.75rem; margin-bottom: 0;">Threads</span>
              </div>
              <div class="control">
                <div class="tabs is-toggle is-small" data-controller="radio-tab">
                  <ul>
                    <li data-radio-tab-target="tab" data-radio-tab-value="true" data-action="click->radio-tab#toggle">
                      <a>
                        Yes
                      </a>
                    </li>
                    <li data-radio-tab-target="tab" data-radio-tab-value="false" data-action="click->radio-tab#toggle">
                      <a>
                        No
                      </a>
                    </li>
                  </ul>
                  <%= form.hidden_field :post_to_threads, value: @entry.post_to_threads.to_s, 'data-radio-tab-target': 'field' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <footer class="modal-card-foot">
      <div class="field is-grouped">
        <p class="control">
          <%= form.submit "Save", class: 'button is-success' %>
        </p>
        <p class="control">
          <button class="button is-light" data-action="click->modal#close">Cancel</button>
        </p>
      </div>
    </footer>
    <% end %>
  </div>
</div>

