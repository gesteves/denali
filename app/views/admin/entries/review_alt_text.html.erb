<% cache [@photoblog, @page] do %>
  <h1 class="title is-size-5-mobile">Alt text review</h1>
  <h2 class="subtitle is-size-6-mobile"><%= pluralize_with_delimiter 'entry', @entries_count %></h2>
  <hr class="hr">
  <% if @entries.size == 0 %>
    <article class="message is-info">
      <div class="message-body">
        You don’t have any entries where the alt text needs to be reviewed. Yay!
      </div>
    </article>
  <% else %>
    <%= render partial: 'entry', collection: @entries, cached: true %>
    <%= paginate @entries, views_prefix: 'admin', outer_window: 1, window: 1 %>
  <% end %>
<% end %>
