<h1 class="title is-size-5-mobile">Review alt text</h1>
<h2 class="subtitle is-size-6-mobile"><%= @entry.plain_title %></h2>
<hr class="hr">

<% @entry.photos.each do |photo| %>
  <div class="box" data-controller="alt-text-review"
       data-alt-text-review-generate-url-value="<%= generate_alt_text_admin_photo_path(photo) %>"
       data-alt-text-review-approve-url-value="<%= approve_alt_text_admin_photo_path(photo) %>"
       data-alt-text-review-dismiss-url-value="<%= dismiss_alt_text_admin_photo_path(photo) %>">
    <div class="columns">
      <div class="column is-one-third">
        <div class="card-image">
          <div class="image image-container">
            <%= responsive_image_tag(
              photo: photo,
              srcset: @srcset,
              sizes: @sizes,
              html_options: {
                class: 'placeholder',
                style: css_placeholder_background(photo),
                'data-controller': 'placeholder',
                'data-action': 'load->placeholder#removeBackground'
              }) %>
          </div>
        </div>
      </div>

      <div class="column">
        <div class="field">
          <label class="label">Alt text</label>
          <div class="notification is-light" data-alt-text-review-target="currentAltText">
            <% if photo.alt_text.present? %>
              <%= photo.alt_text %>
            <% else %>
              <em class="has-text-grey">No alt text set</em>
            <% end %>
          </div>
        </div>

        <div class="field <%= 'is-hidden' unless photo.alt_text_needs_review? %>" data-alt-text-review-target="generatedField">
          <label class="label">AI-generated alt text</label>
          <div class="control">
            <textarea class="textarea" data-alt-text-review-target="generatedAltText"><%= photo.auto_generated_alt_text %></textarea>
          </div>
          <p class="help">Edit as needed before saving, or click “Generate” to get a new suggestion.</p>
        </div>

        <div class="field is-hidden" data-alt-text-review-target="editField">
          <label class="label">Alt text</label>
          <div class="control">
            <textarea class="textarea" data-alt-text-review-target="editAltText"></textarea>
          </div>
        </div>

        <div class="field is-grouped">
          <div class="control" data-alt-text-review-target="generateButtonContainer">
            <button class="button" data-action="click->alt-text-review#generate" data-alt-text-review-target="generateButton">
              <span class="icon"><i class="fas fa-sparkles"></i></span>
              <span>Generate</span>
            </button>
          </div>
          <div class="control <%= 'is-hidden' if photo.alt_text_needs_review? %>" data-alt-text-review-target="editButtonContainer">
            <button class="button" data-action="click->alt-text-review#edit" data-alt-text-review-target="editButton">Edit</button>
          </div>
          <div class="control <%= 'is-hidden' unless photo.alt_text_needs_review? %>" data-alt-text-review-target="dismissButtonContainer">
            <button class="button is-danger" data-action="click->alt-text-review#dismiss" data-alt-text-review-target="dismissButton">Dismiss</button>
          </div>
          <div class="control <%= 'is-hidden' unless photo.alt_text_needs_review? %>" data-alt-text-review-target="saveButtonContainer">
            <button class="button is-success" data-action="click->alt-text-review#save" data-alt-text-review-target="saveButton">Save</button>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
