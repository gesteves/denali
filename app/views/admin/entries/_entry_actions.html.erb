<div class="dropdown is-right" data-controller="dropdown">
  <div class="dropdown-trigger">
    <button class="button" data-action="closeDropdowns@document->dropdown#close click@document->dropdown#close click->dropdown#toggle">
      <span>Actions</span>
      <span class="icon is-small">
        <i class="fas fa-angle-down"></i>
      </span>
    </button>
  </div>
  <div class="dropdown-menu">
    <div class="dropdown-content">
      <%= link_to icon('Edit', 'fas fa-edit'), edit_admin_entry_path(entry), class: 'dropdown-item' %>
      <hr class="dropdown-divider">
      <% if entry.is_photo? %>
        <%= link_to icon('Share', 'fas fa-share-square'), share_admin_entry_path(entry), class: 'dropdown-item', target: '_blank' %>
      <% end %>
      <hr class="dropdown-divider">
      <% if entry.is_photo? %>
        <%= link_to icon('Alt text', 'fas fa-eye-low-vision'), review_alt_text_admin_entry_path(entry), class: 'dropdown-item', target: '_blank' %>
        <%= link_to icon('Crops', 'fas fa-crop'), crops_admin_entry_path(entry), class: 'dropdown-item', target: '_blank' %>
        <%= link_to icon('Prints', 'fas fa-print'), prints_admin_entry_path(entry), class: 'dropdown-item' %>
      <% end %>
      <% if entry.is_photo? && !entry.is_photoset? %>
        <%= link_to icon('Download', 'fas fa-download'), download_admin_entry_photo_path(entry_id: entry.id, id: entry.photos.first.id), class: 'dropdown-item' %>
      <% end %>
      <hr class="dropdown-divider">
      <% if entry.is_queued? %>
        <%= button_to draft_admin_entry_path(entry), method: :patch, class: 'dropdown-item', form: { data: { turbo_confirm: 'Are you sure you want to send this entry to the drafts? It will lose its place in the queue.' } } do %>
          <%= icon('Send to drafts', 'fas fa-folder-open') %>
        <% end %>
      <% elsif entry.is_draft? %>
        <%= button_to queue_admin_entry_path(entry), method: :patch, class: 'dropdown-item', form: { data: { turbo_confirm: 'Are you sure you want to send this entry to the queue?' } } do %>
          <%= icon('Send to queue', 'fas fa-clock') %>
        <% end %>
      <% end %>
      <% if !entry.is_published? %>
        <%= button_to publish_admin_entry_path(entry), method: :patch, class: 'dropdown-item has-text-danger', form: { data: { turbo_confirm: "Are you sure you want to publish this entry? This can\u2019t be undone!" } } do %>
          <%= icon('Publish it!', 'fas fa-rocket') %>
        <% end %>
        <hr class="dropdown-divider">
      <% end %>
      <%= button_to admin_entry_path(entry.id), method: :delete, class: 'dropdown-item has-text-danger', form: { data: { turbo_confirm: "Are you absolutely sure you want to delete it forever? This can\u2019t be undone!" } } do %>
        <%= icon('Delete it forever', 'fas fa-trash-alt') %>
      <% end %>
    </div>
  </div>
</div>
