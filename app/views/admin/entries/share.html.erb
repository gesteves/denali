  <%# Mastodon Section %>
  <h2 class="subtitle is-size-5-mobile">Mastodon</h2>
  <div data-controller="share-form character-counter" data-share-form-url-value="<%= mastodon_admin_entry_path(@entry) %>" data-share-form-platform-value="Mastodon" data-character-counter-max-length-value="500">
