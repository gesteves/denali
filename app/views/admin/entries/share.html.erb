<%# Sharing Settings Section - shown for all entries %>
<h2 class="subtitle is-size-5-mobile">Sharing Settings</h2>
<div data-controller="sharing-settings" data-sharing-settings-url-value="<%= sharing_settings_admin_entry_path(@entry) %>">
  <p class="mb-4">Automatically share on...</p>
  <div class="field is-horizontal">
    <div class="field-label">
      <label class="label">Bluesky</label>
    </div>
    <div class="field-body">
      <div class="field">
        <div class="control">
          <div class="tabs is-toggle is-small" data-controller="radio-tab">
            <ul>
              <li data-radio-tab-target="tab" data-radio-tab-value="true" data-action="click->radio-tab#toggle">
                <a>Yes</a>
              </li>
              <li data-radio-tab-target="tab" data-radio-tab-value="false" data-action="click->radio-tab#toggle">
                <a>No</a>
              </li>
            </ul>
            <input type="hidden" value="<%= @entry.post_to_bluesky %>" data-radio-tab-target="field" data-sharing-settings-target="blueskyField" data-action="change->sharing-settings#save">
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-label">
      <label class="label">Mastodon</label>
    </div>
    <div class="field-body">
      <div class="field">
        <div class="control">
          <div class="tabs is-toggle is-small" data-controller="radio-tab">
            <ul>
              <li data-radio-tab-target="tab" data-radio-tab-value="true" data-action="click->radio-tab#toggle">
                <a>Yes</a>
              </li>
              <li data-radio-tab-target="tab" data-radio-tab-value="false" data-action="click->radio-tab#toggle">
                <a>No</a>
              </li>
            </ul>
            <input type="hidden" value="<%= @entry.post_to_mastodon %>" data-radio-tab-target="field" data-sharing-settings-target="mastodonField" data-action="change->sharing-settings#save">
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-label">
      <label class="label">Instagram</label>
    </div>
    <div class="field-body">
      <div class="field">
        <div class="control">
          <div class="tabs is-toggle is-small" data-controller="radio-tab">
            <ul>
              <li data-radio-tab-target="tab" data-radio-tab-value="true" data-action="click->radio-tab#toggle">
                <a>Yes</a>
              </li>
              <li data-radio-tab-target="tab" data-radio-tab-value="false" data-action="click->radio-tab#toggle">
                <a>No</a>
              </li>
            </ul>
            <input type="hidden" value="<%= @entry.post_to_instagram %>" data-radio-tab-target="field" data-sharing-settings-target="instagramField" data-action="change->sharing-settings#save">
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="field is-horizontal">
    <div class="field-label">
      <label class="label">Threads</label>
    </div>
    <div class="field-body">
      <div class="field">
        <div class="control">
          <div class="tabs is-toggle is-small" data-controller="radio-tab">
            <ul>
              <li data-radio-tab-target="tab" data-radio-tab-value="true" data-action="click->radio-tab#toggle">
                <a>Yes</a>
              </li>
              <li data-radio-tab-target="tab" data-radio-tab-value="false" data-action="click->radio-tab#toggle">
                <a>No</a>
              </li>
            </ul>
            <input type="hidden" value="<%= @entry.post_to_threads %>" data-radio-tab-target="field" data-sharing-settings-target="threadsField" data-action="change->sharing-settings#save">
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="help">Entries are automatically shared on the selected platforms when they're first published, and randomly no more than once a year.</p>
</div>
