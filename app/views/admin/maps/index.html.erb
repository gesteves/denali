<% content_for :stylesheets do %>
  <%= stylesheet_link_tag 'mapbox-gl', media: 'all', 'data-turbo-track': 'reload' %>
<% end %>

<% content_for :body_class do %>
  map__body
<% end %>

<% content_for :meta do %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<div class="map__container" data-controller="map" data-map-map-style-value="mapbox://styles/mapbox/outdoors-v11" data-map-api-token-value="<%= ENV['MAPBOX_API_TOKEN'] %>" data-map-markers-url-value="<%= admin_map_markers_path(format: 'json') %>" data-map-photo-url-value="<%= admin_map_photo_path(id: ':id', format: 'json') %>">
  <div id="map" class="map" role="main" data-map-target="container"></div>
  <div class="map__loading" data-map-target="spinner">
    <%= inline_svg :circle_notch_solid_full, class_name: 'map__loading-spinner' %>
  </div>
</div>
