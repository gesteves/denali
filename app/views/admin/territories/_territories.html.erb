<% cache territories do %>
  <% if territories.present? %>
    <h2 class="title is-size-5-mobile">Native Lands</h2>
    <h3 class="subtitle is-size-6-mobile"><%= pluralize_with_delimiter 'territory', territories.size %></h3>
    <hr class="hr">
    <table class="table is-fullwidth is-hoverable is-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Entries</th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: 'territory', collection: territories, as: :territory %>
      </tbody>
    </table>
  <% end %>
<% end %>
