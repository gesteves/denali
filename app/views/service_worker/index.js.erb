(function() {
  'use strict';

  self.addEventListener('install', () => {
    self.skipWaiting();
  });

  // Takes over open pages straight away, and clears out whatever caches an
  // older version of this worker left behind (the 2018 one cached pages; this
  // one caches nothing, so every cache on the origin is stale).
  self.addEventListener('activate', event => {
    event.waitUntil((async () => {
      const keys = await caches.keys();
      await Promise.all(keys.map(key => caches.delete(key)));
      await self.clients.claim();
    })());
  });

  self.addEventListener('push', event => {
    // Push services can send a push with no payload (to test a subscription,
    // say), and there's nothing to show for one.
    if (!event.data) return;

    let data;
    try {
      data = event.data.json();
    } catch {
      return;
    }

    const options = {
      body: data.body,
      icon: data.icon,
      image: data.image,
      data: {
        dateOfArrival: Date.now(),
        primaryKey: data.primaryKey || '-',
        url: data.url
      }
    };

    event.waitUntil(self.registration.showNotification(data.title, options));
  });

  // Focuses a tab that's already showing the entry, rather than opening
  // another; the notification's URL carries UTM parameters the tab may not.
  self.addEventListener('notificationclick', event => {
    event.notification.close();
    const url = event.notification.data?.url;
    if (!url) return;

    event.waitUntil((async () => {
      const path = new URL(url).pathname;
      const windows = await self.clients.matchAll({ type: 'window', includeUncontrolled: true });
      const existing = windows.find(client => new URL(client.url).pathname === path);
      return existing ? existing.focus() : self.clients.openWindow(url);
    })());
  });
})();
