{
  "name": "denali",
  "version": "1.0.0",
  "description": "A simple, fast photoblogging CMS built in Ruby on Rails which features responsive, high-resolution images. You can see it live at [All-Encompassing Trip](http://www.allencompassingtrip.com).",
  "main": "Gulpfile.js",
  "scripts": {
    "build": "node node_modules/esbuild/bin/esbuild app/frontend/packs/application.js app/frontend/packs/admin.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:watch": "node node_modules/esbuild/bin/esbuild app/frontend/packs/application.js app/frontend/packs/admin.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --watch=forever"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@rails/ujs": "^7.1",
    "esbuild": "^0.25.0",
    "@shopify/draggable": "1.0.0-beta.7",
    "awesomplete": "^1.1.5",
    "bulma": "^1.0.0",
    "caniuse-lite": "^1.0.30001766",
    "clipboard": "^2.0.11",
    "croppr": "^2.3.1",
    "grapheme-splitter": "^1.0.4",
    "leaflet-hash": "^0.2.1",
    "leaflet.markercluster": "^0.5.0",
    "masonry-layout": "^4.2.2",
    "moment-timezone": "^0.6.0",
    "turbolinks": "^5.2.0"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "eslint": "^4.0.0",
    "gulp": "^5.0.1",
    "gulp-cheerio": "^1.0",
    "gulp-jshint": "^2.0",
    "gulp-rename": "^2.1",
    "gulp-replace": "^1.1.4",
    "gulp-scss-lint": "^1.0.0",
    "gulp-scss-lint-stylish": "^1.0",
    "gulp-svgmin": "^4.1",
    "gulp-svgstore": "^9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gesteves/denali.git"
  },
  "author": "Guillermo Esteves",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/gesteves/denali/issues"
  },
  "homepage": "https://github.com/gesteves/denali#readme"
}
