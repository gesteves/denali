{
  "name": "denali",
  "version": "1.0.0",
  "description": "A simple, fast photoblogging CMS built in Ruby on Rails which features responsive, high-resolution images. You can see it live at [All-Encompassing Trip](http://www.allencompassingtrip.com).",
  "main": "app/frontend/packs/application.js",
  "scripts": {
    "build": "esbuild app/frontend/packs/application.js --bundle --sourcemap --format=esm --minify --legal-comments=none --outdir=app/assets/builds --public-path=/assets && esbuild app/frontend/packs/admin.js --bundle --sourcemap --format=esm --minify --legal-comments=none --splitting --chunk-names=[name]-[hash].digested --outdir=app/assets/builds --public-path=/assets",
    "build:watch": "esbuild app/frontend/packs/application.js --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --watch=forever & esbuild app/frontend/packs/admin.js --bundle --sourcemap --format=esm --splitting --chunk-names=[name]-[hash].digested --outdir=app/assets/builds --public-path=/assets --watch=forever",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"app/assets/stylesheets/**/*.scss\""
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "@shopify/draggable": "1.2.1",
    "awesomplete": "^1.1.5",
    "bulma": "^1.0.0",
    "croppr": "^2.3.1",
    "esbuild": "^0.28.2",
    "mapbox-gl": "^3.32.0",
    "masonry-layout": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gesteves/denali.git"
  },
  "author": "Guillermo Esteves",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/gesteves/denali/issues"
  },
  "homepage": "https://github.com/gesteves/denali#readme"
}
