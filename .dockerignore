# Git
.git
.gitignore

# Logs
log/*
*.log

# Temp files
tmp/*
!tmp/.keep

# Editor/IDE
.idea
.vscode
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Test
test/
spec/
coverage/

# Documentation
README.md
docs/

# Node
node_modules/

# Ruby
.bundle
vendor/bundle

# Local env
.env*
!.env.example

# Built assets (will be rebuilt)
public/packs*
public/assets

# Local database dumps
*.dump

# Built by the image itself (npm run build during assets:precompile); a local
# build would only add stale chunks.
app/assets/builds/*
!app/assets/builds/.keep
