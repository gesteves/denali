# ==============================================================================
# Required
# ==============================================================================

# AWS credentials for S3 storage and CloudFront CDN.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_DISTRIBUTION_ID=

# S3 bucket for storing uploaded photos.
S3_BUCKET=
S3_REGION=

# Primary domain name for the application.
DOMAIN=

# Google OAuth2 credentials for admin authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Image processing service (Thumbor).
THUMBOR_DOMAIN=
THUMBOR_SECURITY_KEY=

# Secret used for internal API authentication. Generate with `bundle exec rails secret`.
DENALI_SECRET=

# Rails secret key base. Generate with `bundle exec rails secret`.
SECRET_KEY_BASE=

# Active Record Encryption keys. Generate each with `bundle exec rails secret`.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ==============================================================================
# Infrastructure (set automatically in Docker/Fly.io, override if needed)
# ==============================================================================

# PostgreSQL connection string (auto-set by Fly.io in production).
# DATABASE_URL=

# Redis URL for Sidekiq job queue (auto-set in Docker).
# REDIS_URL=redis://localhost:6379/0

# Redis URL for fragment caching (production only, separate from Sidekiq Redis).
# REDIS_CACHE_URL=

# Elasticsearch URL for full-text search (auto-set in Docker).
# ELASTICSEARCH_URL=http://localhost:9200

# ==============================================================================
# Optional
# ==============================================================================

# Short domain for shortened URLs.
# DOMAIN_SHORT=

# Separate admin domain (used for OAuth callbacks in production).
# DOMAIN_ADMIN=

# Optional path prefix for Thumbor URLs.
# THUMBOR_PATH=

# Restrict admin login to a Google Workspace domain.
# GOOGLE_APPS_DOMAIN=

# CDN/asset host for serving static assets.
# ASSET_HOST=

# Bearer token for authenticating GraphQL API requests.
# GRAPHQL_AUTH_TOKEN=

# Cache time-to-live in seconds.
# CACHE_TTL=

# S3 bucket for automated database backups.
# DB_BACKUP_BUCKET=

# ==============================================================================
# Optional: Google APIs
# ==============================================================================

# Google Maps Geocoding API key. Enables auto-tagging entries with location info.
# GOOGLE_API_KEY=

# ==============================================================================
# Optional: AI alt text generation (Anthropic Claude)
# ==============================================================================

# Enables automatic alt text generation for photos using Claude.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# ==============================================================================
# Optional: Social media cross-posting
# ==============================================================================

# Flickr
# FLICKR_CONSUMER_KEY=
# FLICKR_CONSUMER_SECRET=
# FLICKR_ACCESS_TOKEN=
# FLICKR_ACCESS_TOKEN_SECRET=

# Instagram (Meta Graph API)
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Threads (Meta Graph API)
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# Facebook (used for Open Graph cache scraping)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Mastodon credentials are auto-registered and stored in the database;
# no environment variables needed.

# Bluesky credentials are configured in the admin UI;
# no environment variables needed.

# ==============================================================================
# Optional: Location services
# ==============================================================================

# National Park Service API key. Enables tagging entries with national park info.
# NPS_API_KEY=

# Native Land API key. Enables tagging entries with indigenous territory info.
# NATIVE_LAND_API_KEY=

# ==============================================================================
# Optional: Maps
# ==============================================================================

# Mapbox API token. Enables the admin map view.
# MAPBOX_API_TOKEN=

# ==============================================================================
# Optional: Web push notifications (VAPID)
# ==============================================================================

# VAPID_MAILTO_ADDRESS=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ==============================================================================
# Optional: Monitoring & analytics
# ==============================================================================

# Bugsnag error monitoring.
# BUGSNAG_API_KEY=

# Known Agents API for dynamic robots.txt generation.
# KNOWN_AGENTS_ACCESS_TOKEN=

# ==============================================================================
# Server tuning (sensible defaults are provided)
# ==============================================================================

# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=0
# SIDEKIQ_CONCURRENCY=10
# PORT=3000
# RAILS_LOG_LEVEL=info
# LOGRAGE_ENABLED=true
# RAILS_SERVE_STATIC_FILES=true
# ELASTICSEARCH_TIMEOUT=60
